# LiveKit agent worker — environment
# Copy to agent/.env and fill in.

# Same LiveKit project as the app
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=lead-qualifier

# Must match LIVEKIT_WEBHOOK_SECRET in the app's .env.local
LIVEKIT_WEBHOOK_SECRET=

# Where to post the finished transcript (the app's public URL)
# (the app sends this per-call via job metadata; no env needed here)

# STT / LLM / TTS provider keys — depends on the plugins you use in agent.mjs
OPENAI_API_KEY=
