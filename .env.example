# ─────────────────────────────────────────────────────────────
# Vector Lead — environment
#
# EVERYTHING IS OPTIONAL. With no keys set, the app runs in MOCK MODE:
# seeded sample leads, simulated calls, and heuristic scoring — fully
# demoable. Add each key below to switch that piece to live automatically.
# ─────────────────────────────────────────────────────────────

# Force mock mode even if keys are present (handy for local demos)
# MOCK_MODE=1

# Public base URL of THIS app (used for OAuth redirects & webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave empty: the API is served by this same Next.js app (relative URLs).
# Set only to point the UI at a separate backend host.
NEXT_PUBLIC_API_URL=

# ── Supabase (auth + database) ──
# Present url+anon → real login is enforced. Add the service-role key too to
# persist data in Postgres instead of the in-memory store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (AI lead scoring) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Vapi (outbound voice calls) ──
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# ── LiveKit (outbound voice calls via SIP + agent) ──
# Takes precedence over Vapi when all four below are set. The agent worker
# (see agent/) conducts the call and posts the transcript to
# POST /api/webhooks/livekit. Requires a LiveKit project + an outbound SIP trunk.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_AGENT_NAME=lead-qualifier
# Shared secret the agent sends back (x-livekit-secret); also set it in agent/.env
LIVEKIT_WEBHOOK_SECRET=

# ── Meta / Facebook Lead Ads ──
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_REDIRECT_URI=

# ── n8n (hybrid pipeline orchestration) ──
# When N8N_CALL_WEBHOOK_URL is set, "Call Now" delegates the whole
# call → score → notify flow to your n8n workflow instead of running it
# internally. n8n posts results back to POST /api/webhooks/n8n.
# The secret is sent as `x-n8n-secret` and required on inbound callbacks.
N8N_CALL_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
